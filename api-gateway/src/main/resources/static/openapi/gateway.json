              "X-Correlation-Id": {
                "description": "Identificador conservado si es válido; generado si falta o es inválido.",
                "schema": {
                  "type": "string"
                },
                "example": "demo-request-01"
              },
              "X-Validated-Roles": {
                "description": "Roles verificados separados por coma. Puede estar vacío. No enviar este header como credencial.",
