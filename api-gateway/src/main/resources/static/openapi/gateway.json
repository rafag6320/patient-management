  "components": {
    "schemas": {
      "PatientCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Obligatorio; no puede contener sólo espacios."
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1,
            "maxLength": 255
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Obligatorio; no puede contener sólo espacios."
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Fecha calendario válida yyyy-MM-dd. Sin restricción de edad."
          },
          "registeredDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Obligatoria para crear. No se devuelve en la respuesta."
          },
          "DNI": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "^[0-9]{1,10}$",
            "description": "Mayúsculas en la petición. Valor numérico de 0 a 2147483647; admite ceros iniciales."
          }
        },
        "required": [
          "DNI",
          "address",
          "dateOfBirth",
          "email",
          "name",
          "registeredDate"
        ]
      },
      "PatientUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Obligatorio; no puede contener sólo espacios."
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1,
            "maxLength": 255
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Obligatorio; no puede contener sólo espacios."
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Fecha calendario válida yyyy-MM-dd. Sin restricción de edad."
          },
          "registeredDate": {
            "type": "string",
            "nullable": true,
            "description": "Opcional e ignorada al actualizar. Si se envía un valor no vacío debe ser fecha calendario yyyy-MM-dd. También admite null o espacios."
          },
          "DNI": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "^[0-9]{1,10}$",
            "description": "Mayúsculas en la petición. Valor numérico de 0 a 2147483647; admite ceros iniciales."
          }
        },
        "required": [
          "DNI",
          "address",
          "dateOfBirth",
          "email",
          "name"
        ]
      },
      "Patient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "address": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "dni": {
            "type": "string",
            "description": "Minúsculas en la respuesta; valor numérico canónico, sin ceros iniciales."
          }
        },
        "required": [
          "address",
          "dateOfBirth",
          "dni",
          "email",
          "id",
          "name"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "writeOnly": true,
            "description": "No puede contener sólo espacios."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT emitido por auth. Usarlo en Authorize sin el prefijo Bearer."
          }
        },
        "required": [
          "token"
        ]
      },
      "AnalyticsSummary": {
        "type": "object",
        "properties": {
          "patientsCreated": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Altas históricas distintas PATIENT_CREATED por patientId. No es el total de pacientes activos; PUT/DELETE no lo reducen."
          }
        },
        "required": [
          "patientsCreated"
        ]
      },
      "ErrorBody": {
        "description": "Los handlers de patient devuelven error o un mapa campo/mensaje. Errores del framework pueden tener otro cuerpo o estar vacíos. Auth y filtros JWT pueden responder sin cuerpo.",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "detail": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              },
              "timestamp": {
                "type": "string"
              },
              "error": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "description": "Opcional. Se conserva si cumple [A-Za-z0-9._:-]{1,64}; en otro caso se genera un UUID y se devuelve en la respuesta. Un valor inválido no rechaza la petición.",
        "schema": {
          "type": "string"
        },
        "example": "demo-request-01"
      },
      "PatientId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "8c820e3b-83ef-4536-8327-26e8990bd608"
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Recomendado para recuperar POST inciertos. Misma clave y payload lógico devuelve el snapshot original; cambiar el payload produce 409. Sin clave también se admite crear.",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]{16,128}$"
        },
        "example": "patient-demo-20261031-0001"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de POST /api/auth/login. ADMIN: CRUD y analytics. USER: sólo GET de pacientes y analytics."
      }
    }
  }
}
