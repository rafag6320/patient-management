      "post": {
        "operationId": "createPatient",
        "tags": [
          "Pacientes"
        ],
        "summary": "Crear o recuperar un alta",
        "description": "ADMIN. El mismo Idempotency-Key con el mismo payload lógico recupera el snapshot original aunque el paciente se haya actualizado. Fechas y DNI se normalizan; nombre, email y dirección se comparan exactamente. Un 503 puede corresponder a un alta pendiente/incierta: reutilizar la clave, no generar otra. Kafka y analytics se recuperan en segundo plano después del 200.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Paciente persistido, billing confirmado y evento registrado durablemente. Puede faltar entrega Kafka/analytics.",
