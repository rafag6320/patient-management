                "example": {
                  "id": "8c820e3b-83ef-4536-8327-26e8990bd608",
                  "name": "Ana Pérez",
                  "email": "ana@example.com",
                  "address": "Calle Ejemplo 123",
                  "dateOfBirth": "1990-05-20",
                  "dni": "30123456"
                }
              }
            }
          },
          "400": {
            "description": "Validación fallida, Idempotency-Key inválida o email/DNI duplicados con otra clave o sin clave.",
