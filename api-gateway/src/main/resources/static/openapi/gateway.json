              "X-Correlation-Id": {
                "description": "Identificador conservado si es válido; generado si falta o es inválido.",
                "schema": {
                  "type": "string"
                },
                "example": "demo-request-01"
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas; sin cuerpo.",
            "headers": {
              "X-Correlation-Id": {
                "description": "Identificador conservado si es válido; generado si falta o es inválido.",
                "schema": {
                  "type": "string"
